# Payrails endpoints
PAYRAILS_CLIENT_INIT_URL=https://api.staging.payrails.io/merchant/client/init
PAYRAILS_EXECUTION_URL=https://api.staging.payrails.io/merchant/workflows/payment-acceptance/executions

# OAuth token endpoint (Bearer token). When set, the backend auto-fetches tokens for
# /api/payrails/init and /api/executions.
PAYRAILS_AUTH_URL=https://api.staging.payrails.io/auth/token/{clientId}
PAYRAILS_CLIENT_ID=<fill me>
PAYRAILS_API_KEY=<fill me>

# Environment for Payrails.init
PAYRAILS_ENVIRONMENT=TEST

# Merchant reference prefix
PAYRAILS_MERCHANT_REFERENCE_PREFIX=demo

# Optional JSON to merge into init/execution payloads
# Example: {"accountId":"acc_123"}
PAYRAILS_INIT_EXTRA_JSON={}
PAYRAILS_EXECUTION_EXTRA_JSON={}
